[DEFAULT]
bantime  = 24h
findtime = 10m
maxretry = 3
banaction = iptables-multiport
ignoreip = 127.0.0.1/8 ::1 192.168.1.0/24 100.64.0.0/10

[sshd]
enabled = true
port    = ssh
logpath = /var/log/auth.log
backend = %(sshd_backend)s
maxretry = 3
bantime = 48h

[npm-badbots]
enabled = true
port = http,https
filter = npm-badbots
logpath = /var/log/npm/default-host_access.log
maxretry = 2
bantime = 72h
