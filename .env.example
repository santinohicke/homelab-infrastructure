# ==============================================================================
# HOMELAB INFRASTRUCTURE - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copia este archivo como '.env' antes de ejecutar 'docker compose up -d':
#   cp .env.example .env
# NUNCA subas tu archivo '.env' real a ningún repositorio público.
# ==============================================================================

# Dominio base del homelab (Local o FQDN público)
HOMELAB_DOMAIN=homelab.local
SERVER_HOST_IP=192.168.1.100

# Zona Horaria y Localización
TZ=America/Argentina/Buenos_Aires

# Directorio raíz en el servidor donde se almacenan los datos persistentes
DATA_ROOT=/opt/homelab/data

# Configuración Nginx Proxy Manager & SSL
ADMIN_EMAIL=admin@homelab.local
DISABLE_IPV6=true

# Vaultwarden (Bitwarden Self-Hosted)
# Genera un token seguro con: openssl rand -base64 48
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_WEBSOCKET_ENABLED=true
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_TO_A_SECURE_RANDOM_TOKEN_HERE

# Pi-hole DNS Ad-blocker
# Contraseña para acceder a la interfaz web de Pi-hole
WEBPASSWORD=ChangeThisSecurePassword123!
PIHOLE_DNS_PRIMARY=1.1.1.1
PIHOLE_DNS_SECONDARY=1.0.0.1

# Tailscale (Mesh VPN Overlay)
# Auth key opcional para auto-conexión (generar en admin console de Tailscale)
# TS_AUTHKEY=tskey-auth-k123456789...

# Monitoreo & Notificaciones (Opcional)
# UPTIME_KUMA_PORT=3001
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
